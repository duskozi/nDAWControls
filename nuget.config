<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- lib/packages holds NinePatch.Core and NinePatchWpf until they are published on nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="lib/packages" />
  </packageSources>
</configuration>
