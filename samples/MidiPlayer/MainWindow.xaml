<Window x:Class="nDAWControls.MidiPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:daw="urn:ndaw-controls"
        Title="nDAWControls MIDI Player" Width="1500" Height="920" MinWidth="900" MinHeight="560"
        Background="{DynamicResource {x:Static daw:DawSkinKeys.WindowBackground}}"
        TextElement.Foreground="{DynamicResource {x:Static daw:DawSkinKeys.Text}}"
        TextElement.FontFamily="{DynamicResource {x:Static daw:DawSkinKeys.FontFamily}}"
        UseLayoutRounding="True" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ViewChip" TargetType="daw:LedToggleButton">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="IsChecked" Value="True"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static daw:DawSkinKeys.TextDim}}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- App bar (always visible): file, view toggles, skin, MIDI strip -->
        <Border DockPanel.Dock="Top" Padding="8,5" BorderThickness="0,0,0,1"
                Background="{DynamicResource {x:Static daw:DawSkinKeys.PanelRaised}}"
                BorderBrush="{DynamicResource {x:Static daw:DawSkinKeys.PanelBorder}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <daw:LedToggleButton Content="Open…" Height="22" Padding="10,0" Click="OnOpen" ToolTip="Open a MIDI file (or drop one on the window)"/>
                    <daw:LedToggleButton Content="Demo song" Height="22" Padding="10,0" Margin="4,0,0,0" Click="OnDemo"/>
                    <daw:LedToggleButton Content="Panic" Height="22" Padding="10,0" Margin="4,0,12,0" Click="OnPanic"
                                         ToolTip="All notes off on every device"/>
                    <TextBlock x:Name="SongTitle" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <daw:MidiActivityMonitor x:Name="MidiStrip" Layout="Compact" Width="200" Height="20" Margin="0,0,12,0"
                                             Visibility="{Binding IsChecked, ElementName=StripChip, Converter={StaticResource BoolToVis}}"
                                             ToolTip="MIDI out, 16 channels · top = notes, bottom = controllers"/>
                </StackPanel>

                <!-- Every part of the UI can be hidden; hidden parts receive no data. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="VIEW" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
                    <daw:LedToggleButton Content="Transport" Style="{StaticResource ViewChip}" IsChecked="{Binding IsShown, ElementName=TransportPanel, Mode=TwoWay}"/>
                    <daw:LedToggleButton Content="Tracks" Style="{StaticResource ViewChip}" IsChecked="{Binding IsShown, ElementName=TracksPanel, Mode=TwoWay}"/>
                    <daw:LedToggleButton Content="Piano roll" Style="{StaticResource ViewChip}" IsChecked="{Binding IsShown, ElementName=RollPanel, Mode=TwoWay}"/>
                    <daw:LedToggleButton Content="Lane" Style="{StaticResource ViewChip}" IsChecked="{Binding IsShown, ElementName=LanePanel, Mode=TwoWay}"/>
                    <daw:LedToggleButton Content="Channels" Style="{StaticResource ViewChip}" IsChecked="{Binding IsShown, ElementName=ChannelsPanel, Mode=TwoWay}"/>
                    <daw:LedToggleButton Content="Keyboard" Style="{StaticResource ViewChip}" IsChecked="{Binding IsShown, ElementName=KeyboardPanel, Mode=TwoWay}"/>
                    <daw:LedToggleButton x:Name="StripChip" Content="MIDI strip" Style="{StaticResource ViewChip}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Transport -->
        <daw:DawPanel x:Name="TransportPanel" DockPanel.Dock="Top" ShowHeader="False" Padding="0" BorderThickness="0"
                      Background="Transparent">
            <daw:TransportBar x:Name="Transport"/>
        </daw:DawPanel>

        <!-- Keyboard + wheels + pedals -->
        <daw:DawPanel x:Name="KeyboardPanel" DockPanel.Dock="Bottom" Header="KEYBOARD" Margin="6,0,6,6" Padding="6,2,6,6">
            <daw:DawPanel.Tools>
                <StackPanel Orientation="Horizontal">
                    <daw:LedToggleButton x:Name="WheelsChip" Content="Wheels" Style="{StaticResource ViewChip}"/>
                    <daw:LedToggleButton x:Name="PedalsChip" Content="Pedals" Style="{StaticResource ViewChip}"/>
                    <daw:LedToggleButton x:Name="Keys3DChip" Content="3D" Style="{StaticResource ViewChip}" Checked="OnKeyStyle" Unchecked="OnKeyStyle"/>
                </StackPanel>
            </daw:DawPanel.Tools>
            <DockPanel Height="100">
                <DockPanel DockPanel.Dock="Left" Margin="0,0,10,0">
                    <daw:PianoPedals x:Name="Pedals" DockPanel.Dock="Bottom" Margin="0,5,0,0" PedalChanged="OnPedalChanged"
                                     Visibility="{Binding IsChecked, ElementName=PedalsChip, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsChecked, ElementName=WheelsChip, Converter={StaticResource BoolToVis}}">
                        <daw:PerformanceWheel x:Name="PitchWheel" Mode="PitchBend" Margin="0,0,6,0" ValueChanged="OnWheelChanged"/>
                        <daw:PerformanceWheel x:Name="ModWheel" Mode="Modulation" ValueChanged="OnWheelChanged"/>
                    </StackPanel>
                </DockPanel>
                <daw:PianoKeyboard x:Name="Keys" Height="100" LowestNote="21" HighestNote="108"
                                   NoteOn="OnKeyNoteOn" NoteOff="OnKeyNoteOff"
                                   ToolTip="Plays on the selected track's device and channel"/>
            </DockPanel>
        </daw:DawPanel>

        <!-- Tracks -->
        <daw:DawPanel x:Name="TracksPanel" DockPanel.Dock="Left" Width="350" Header="TRACKS" Margin="6,6,0,6" Padding="0">
            <daw:DawPanel.Tools>
                <StackPanel Orientation="Horizontal">
                    <daw:LedToggleButton x:Name="DevicesChip" Content="Devices" Style="{StaticResource ViewChip}" ToolTip="Show output device selectors"/>
                    <daw:LedToggleButton x:Name="ActivityChip" Content="Activity" Style="{StaticResource ViewChip}" ToolTip="Show activity lights"/>
                </StackPanel>
            </daw:DawPanel.Tools>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TrackList"/>
            </ScrollViewer>
        </daw:DawPanel>

        <!-- Channel activity -->
        <daw:DawPanel x:Name="ChannelsPanel" DockPanel.Dock="Right" Width="340" Header="MIDI CHANNELS" Margin="0,6,6,6" Padding="0,2,0,4">
            <daw:DawPanel.Tools>
                <StackPanel Orientation="Horizontal">
                    <daw:LedToggleButton x:Name="NoteMapChip" Content="Notes" Style="{StaticResource ViewChip}"/>
                    <daw:LedToggleButton x:Name="CtrlTextChip" Content="Ctrl" Style="{StaticResource ViewChip}"/>
                </StackPanel>
            </daw:DawPanel.Tools>
            <daw:MidiActivityMonitor x:Name="ChannelMonitor" Source="Channels" RowHeight="16" VerticalAlignment="Top"
                                     LowestNote="21" HighestNote="108"
                                     ShowNoteMap="{Binding IsChecked, ElementName=NoteMapChip}"
                                     ShowControlText="{Binding IsChecked, ElementName=CtrlTextChip}"/>
        </daw:DawPanel>

        <!-- Piano roll + lane -->
        <DockPanel Margin="6">
            <daw:DawPanel x:Name="LanePanel" DockPanel.Dock="Bottom" Header="CONTROLLER LANE · SELECTED TRACK" Margin="0,6,0,0" Padding="0">
                <daw:DawPanel.Tools>
                    <ComboBox x:Name="LanePicker" Width="140" SelectionChanged="OnLaneModeChanged"
                              Style="{DynamicResource {x:Static daw:DawStyleKeys.ComboBox}}"/>
                </daw:DawPanel.Tools>
                <daw:ControllerLane x:Name="Lane" Height="96" Roll="{Binding ElementName=Roll}" IsHitTestVisible="False"/>
            </daw:DawPanel>

            <daw:DawPanel x:Name="RollPanel" Header="PIANO ROLL" Padding="0">
                <daw:DawPanel.Tools>
                    <daw:LedToggleButton x:Name="FollowChip" Content="Follow" Style="{StaticResource ViewChip}"
                                         ToolTip="Scroll with the playhead"/>
                </daw:DawPanel.Tools>
                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <daw:PianoRoll x:Name="Roll" IsReadOnly="True" Snap="0.25" PixelsPerBeat="48" KeyHeight="10"
                                   FollowPlayhead="{Binding IsChecked, ElementName=FollowChip}"/>
                </ScrollViewer>
            </daw:DawPanel>
        </DockPanel>
    </DockPanel>
</Window>
