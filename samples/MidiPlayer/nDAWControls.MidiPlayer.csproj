<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- x64, so the controls use the native nine-patch renderer. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>nDAWControls.MidiPlayer</RootNamespace>
    <AssemblyName>nDAWControls.MidiPlayer</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\nDAWControls\nDAWControls.csproj" />
  </ItemGroup>

</Project>
