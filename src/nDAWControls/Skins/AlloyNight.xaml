<!-- AlloyNight skin of nDAWControls. Alloy on dark anodised metal: the same light and depth, blue glass displays, orange accents. The piano keys keep the standard look. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:skin="clr-namespace:nDAWControls.Skinning">
    <!-- Skin: AlloyNight -->
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.WindowBackground}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF1E2024"/>
        <GradientStop Offset="1" Color="#FF141518"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.PanelBackground}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF464A51"/>
        <GradientStop Offset="1" Color="#FF26282C"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.PanelRaised}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF52565D"/>
        <GradientStop Offset="1" Color="#FF33363B"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PanelBorder}" Color="#FF0E0F11" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Text}" Color="#FFE3E7EC" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.TextDim}" Color="#FF9CA4AE" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Accent}" Color="#FFFF9A1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.AccentForeground}" Color="#FF2A1600" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Focus}" Color="#99FF9A1F" po:Freeze="True"/>
    <RadialGradientBrush x:Key="{x:Static skin:DawSkinKeys.KnobBody}" GradientOrigin="0.35,0.25" Center="0.4,0.3" RadiusX="0.8" RadiusY="0.8" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF7A7F87"/>
        <GradientStop Offset="1" Color="#FF202226"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KnobBodyBorder}" Color="#FF6D737B" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KnobTrack}" Color="#FF101114" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KnobIndicator}" Color="#FFFFB04A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.FaderGroove}" Color="#FF0B0C0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.FaderFill}" Color="#AAFF9A1F" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.FaderThumb}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFFAFBFC"/>
        <GradientStop Offset="1" Color="#FF9AA1A9"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.FaderThumbBorder}" Color="#FF0B0C0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.FaderThumbLine}" Color="#FFFF9A1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterBackground}" Color="#FF0A0C0F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterSafe}" Color="#FF3EA2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterWarning}" Color="#FFFFB12A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterDanger}" Color="#FFFF3B2F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterPeakHold}" Color="#FFE6F4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterClipOn}" Color="#FFFF3B2F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.MeterClipOff}" Color="#FF2E1C1B" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ScaleTick}" Color="#FF5A6069" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ScaleText}" Color="#FF8E96A0" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.ButtonBackground}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF50545B"/>
        <GradientStop Offset="1" Color="#FF35383E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.ButtonHover}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF5A5F66"/>
        <GradientStop Offset="1" Color="#FF3E4248"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.ButtonPressed}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF2A2C31"/>
        <GradientStop Offset="1" Color="#FF34373C"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ButtonBorder}" Color="#FF0B0C0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedMute}" Color="#FFFF9A1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedSolo}" Color="#FFFFD21F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedArm}" Color="#FFFF3B2F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedMonitor}" Color="#FF3EA2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LedLitForeground}" Color="#FF1A1205" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.TransportPlay}" Color="#FF2FD27F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.TransportRecord}" Color="#FFFF3B2F" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.LcdBackground}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF2690E0"/>
        <GradientStop Offset="1" Color="#FF062C66"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LcdBorder}" Color="#FF8A9098" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LcdText}" Color="#FFEFFAFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LcdTextDim}" Color="#FFC6E9FF" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.KeyWhite}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFF1F2F4"/>
        <GradientStop Offset="1" Color="#FFD3D6DB"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.KeyBlack}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF2E3035"/>
        <GradientStop Offset="1" Color="#FF151619"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KeyBorder}" Color="#FF0E0F11" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KeyPressed}" Color="#FFFF9A3C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.KeyHighlight}" Color="#B04CC2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridBackground}" Color="#FF121417" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridBlackRow}" Color="#FF0E1013" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridBarLine}" Color="#FF3A4A60" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridBeatLine}" Color="#FF26303C" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.GridSubLine}" Color="#FF1B2129" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.NoteFill}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF8FE3FF"/>
        <GradientStop Offset="1" Color="#FF1F86E8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.NoteSelectedFill}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFFFD08A"/>
        <GradientStop Offset="1" Color="#FFFF9A1F"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.NoteBorder}" Color="#FF08376F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.NoteText}" Color="#CC04162E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Playhead}" Color="#FFFFFFFF" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.RulerBackground}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF3A3D43"/>
        <GradientStop Offset="1" Color="#FF26282C"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.RulerText}" Color="#FFB9C0C8" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.Selection}" Color="#333EA2FF" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.StepOff}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF3E4248"/>
        <GradientStop Offset="1" Color="#FF2A2D32"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.StepOn}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FFFFC56A"/>
        <GradientStop Offset="1" Color="#FFFF9414"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.StepGroupBackground}" Color="#FF2A2C30" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.StepPlayhead}" Color="#333EA2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PadBackground}" Color="#FF0F1114" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PadGrid}" Color="#FF242A32" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PadPuck}" Color="#FFFF9A1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PadCrosshair}" Color="#663EA2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.EnvelopeStroke}" Color="#FFFF9A1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.EnvelopeFill}" Color="#40FF9A1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.WheelSlot}" Color="#FF08090B" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.WheelBody}" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF2E3135"/>
        <GradientStop Offset="0.45" Color="#FF5E636A"/>
        <GradientStop Offset="1" Color="#FF2E3135"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.WheelRib}" Color="#FF0B0C0E" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.WheelMarker}" Color="#FFFF9A1F" po:Freeze="True"/>
    <LinearGradientBrush x:Key="{x:Static skin:DawSkinKeys.PedalBody}" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#FF5A5F66"/>
        <GradientStop Offset="1" Color="#FF2E3135"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.PedalLit}" Color="#FFFF9A1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ActivityNote}" Color="#FF3EA2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ActivityControl}" Color="#FFFF9A1F" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ActivityOff}" Color="#FF15171A" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.ActivityRowAlt}" Color="#FF24272B" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.TrackSelected}" Color="#FF3B3F46" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LaneValue}" Color="#FF3EA2FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="{x:Static skin:DawSkinKeys.LaneFill}" Color="#403EA2FF" po:Freeze="True"/>
    <CornerRadius x:Key="{x:Static skin:DawSkinKeys.CornerRadius}">4</CornerRadius>
    <FontFamily x:Key="{x:Static skin:DawSkinKeys.FontFamily}">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="{x:Static skin:DawSkinKeys.LcdFontFamily}">Consolas</FontFamily>
    <sys:Double x:Key="{x:Static skin:DawSkinKeys.KnobArcThickness}">3</sys:Double>
</ResourceDictionary>
