<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:nDAWControls"
                    xmlns:p="clr-namespace:nDAWControls.Primitives"
                    xmlns:s="clr-namespace:nDAWControls.Skinning">
    <Style TargetType="{x:Type c:Knob}">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static s:DawSkinKeys.TextDim}}"/>
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static s:DawSkinKeys.FontFamily}}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="ArcBrush" Value="{DynamicResource {x:Static s:DawSkinKeys.Accent}}"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:Knob}">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Fixed 48x48 design box scaled to the available space keeps proportions on any size. -->
                        <Viewbox Stretch="Uniform">
                            <Grid Width="48" Height="48">
                                <p:ArcElement Stroke="{DynamicResource {x:Static s:DawSkinKeys.KnobTrack}}" Thickness="{DynamicResource {x:Static s:DawSkinKeys.KnobArcThickness}}"
                                              MinAngle="{TemplateBinding MinAngle}" MaxAngle="{TemplateBinding MaxAngle}"
                                              From="0" To="1"/>
                                <p:ArcElement x:Name="ValueArc" Stroke="{TemplateBinding ArcBrush}" Thickness="{DynamicResource {x:Static s:DawSkinKeys.KnobArcThickness}}"
                                              MinAngle="{TemplateBinding MinAngle}" MaxAngle="{TemplateBinding MaxAngle}"
                                              From="{TemplateBinding ArcOrigin}" To="{TemplateBinding NormalizedValue}"/>
                                <Ellipse Margin="8,9.5,6,4.5" Fill="{DynamicResource {x:Static s:DawSkinKeys.KnobShadow}}" IsHitTestVisible="False"/>
                                <Ellipse x:Name="Body" Margin="7" Fill="{DynamicResource {x:Static s:DawSkinKeys.KnobBody}}" Stroke="{DynamicResource {x:Static s:DawSkinKeys.KnobBodyBorder}}" StrokeThickness="1"/>
                                <!-- Grip ribs turn with the knob; the cap and the reflection stay put, lit from the top left. -->
                                <Path Margin="7" Width="34" Height="34" Stroke="{DynamicResource {x:Static s:DawSkinKeys.KnobGrip}}" StrokeThickness="1.1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                                      Data="M17.00,3.60L17.00,0.40M20.47,4.06L21.30,0.97M23.70,5.40L25.30,2.62M26.48,7.52L28.74,5.26M28.60,10.30L31.38,8.70M29.94,13.53L33.03,12.70M30.40,17.00L33.60,17.00M29.94,20.47L33.03,21.30M28.60,23.70L31.38,25.30M26.48,26.48L28.74,28.74M23.70,28.60L25.30,31.38M20.47,29.94L21.30,33.03M17.00,30.40L17.00,33.60M13.53,29.94L12.70,33.03M10.30,28.60L8.70,31.38M7.52,26.48L5.26,28.74M5.40,23.70L2.62,25.30M4.06,20.47L0.97,21.30M3.60,17.00L0.40,17.00M4.06,13.53L0.97,12.70M5.40,10.30L2.62,8.70M7.52,7.52L5.26,5.26M10.30,5.40L8.70,2.62M13.53,4.06L12.70,0.97">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding IndicatorAngle, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Path.RenderTransform>
                                </Path>
                                <Ellipse Margin="12.5" Fill="{DynamicResource {x:Static s:DawSkinKeys.KnobCap}}" IsHitTestVisible="False"/>
                                <Ellipse Margin="7" Fill="{DynamicResource {x:Static s:DawSkinKeys.KnobHighlight}}" IsHitTestVisible="False"/>
                                <Grid Margin="7" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{Binding IndicatorAngle, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </Grid.RenderTransform>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42*"/>
                                        <RowDefinition Height="58*"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Width="2.2" RadiusX="1.1" RadiusY="1.1" Margin="0,3,0,0"
                                               HorizontalAlignment="Center" Fill="{DynamicResource {x:Static s:DawSkinKeys.KnobIndicator}}"/>
                                </Grid>
                                <Ellipse x:Name="FocusRing" Stroke="{DynamicResource {x:Static s:DawSkinKeys.Focus}}" StrokeThickness="1" Visibility="Collapsed"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="LabelText" Grid.Row="1" Text="{TemplateBinding Label}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ValueTextBlock" Grid.Row="1" Text="{TemplateBinding ValueText}"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource {x:Static s:DawSkinKeys.Text}}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LabelText" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="ValueTextBlock" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="LabelText" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="ValueTextBlock" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
